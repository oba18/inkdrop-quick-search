{
  "name": "quick-search",
  "version": "0.0.0",
  "description": "Raycast-style note finder: search notes by title and full text from a shortcut",
  "keywords": [
    "inkdrop",
    "search",
    "telescope",
    "finder"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oba18/inkdrop-quick-search"
  },
  "bugs": {
    "url": "https://github.com/oba18/inkdrop-quick-search/issues"
  },
  "main": "./lib/index.js",
  "files": [
    "lib",
    "keymaps",
    "menus",
    "styles"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@inkdropapp/types": "^0.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "inkdrop-model": "^3.0.1",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "inkdrop": "^6.0.0"
  },
  "styleSheets": [
    "quick-search.css"
  ]
}
